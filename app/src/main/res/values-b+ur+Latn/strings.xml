    <string name="help_topic_1_title">1. Pehli purchase kaise record karein?</string>
    <string name="help_topic_1_desc">Home screen par Buy Items par tap karein. Category chunein, Model aur IMEI enter karein, Seller detail aur payment info add karein, phir Save par tap karein.</string>
    <string name="help_topic_2_title">2. Item kaise bechein?</string>
    <string name="help_topic_2_desc">Home screen par Sell Items par tap karein. Stock se phone chunein, Customer detail, sale price aur received amount enter karein, phir Save par tap karein.</string>
    <string name="help_topic_3_title">3. Partial payments kaise record karein?</string>
    <string name="help_topic_3_desc">Partial payment ke saath khareedne ya bechne par remaining balance khud calculate hota hai. Wizard mein promised return date set karein.</string>
    <string name="help_topic_4_title">4. Customer dues baad mein kaise wasool karein?</string>
    <string name="help_topic_4_desc">Home -&gt; Ledger par jayein. Customer ke naam par tap karein, phir received cash record karne ke liye Receive Payment button par tap karein.</string>
    <string name="help_topic_5_title">5. Phone exchange kaise process karein?</string>
    <string name="help_topic_5_desc">Home par Exchange par tap karein. Purane item ki purchase details aur naye item ki sale details ek hi unified screen par enter karein.</string>
    <string name="help_topic_6_title">6. Staff members ko invite kaise karein?</string>
    <string name="help_topic_6_desc">Settings -&gt; Team -&gt; Copy Invite Code par jayein aur code WhatsApp ke zariye staff ko bhejein. Staff member app setup ke doran code enter karke join karta hai.</string>
    <string name="help_topic_7_title">7. Profit kahan dekhein (Owner)?</string>
    <string name="help_topic_7_desc">Home top bar par Settings ke bagal mein Dashboard icon par tap karein. Monthly net profit aur analytics card dekhein.</string>
    <string name="dashboard_help_today_sales_title">Aaj ki Sales kya hain?</string>
    <string name="dashboard_help_today_sales_msg">Aaj raat 12 baje se ab tak record ki gayi tamam device sales ka total.</string>
    <string name="dashboard_help_profit_title">Monthly Profit kaise calculate hota hai?</string>
    <string name="dashboard_help_profit_msg">Is mahine ki total sales minus bike hue items ki purchase cost minus shop expenses (Rent, Electricity, Maintenance).</string>
    <string name="dashboard_help_capital_title">Capital in Stock kya hai?</string>
    <string name="dashboard_help_capital_msg">Aapke shop stock mein maujood tamam unsold inventory ki total purchase value.</string>
    <string name="dashboard_help_slow_stock_title">Slow Stock kya hai?</string>
    <string name="dashboard_help_slow_stock_msg">Woh mobile phones jo shop stock mein 30 din se zyada unsold pade hain.</string>
