rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Optimized, Flat Helper Functions ---

    function isAuthenticated() {
      return request.auth != null;
    }

    function getShopOwner(shopId) {
      return get(/databases/$(database)/documents/shops/$(shopId)).data.owner_user_id;
    }

    function getMemberRole(shopId) {
      return exists(/databases/$(database)/documents/shops/$(shopId)/members/$(request.auth.uid))
        ? get(/databases/$(database)/documents/shops/$(shopId)/members/$(request.auth.uid)).data.role
        : null;
    }

    function isShopOwner(shopId) {
      return isAuthenticated() && (
        getShopOwner(shopId) == request.auth.uid ||
        getMemberRole(shopId) == 'OWNER'
      );
    }

    function isShopMember(shopId) {
      return isAuthenticated() && (
        getShopOwner(shopId) == request.auth.uid ||
        getMemberRole(shopId) != null
      );
    }

    function isStaff(shopId) {
      return isAuthenticated() && getMemberRole(shopId) == 'STAFF';
    }

    function isPartner(shopId) {
      return isAuthenticated() && getMemberRole(shopId) == 'PARTNER';
    }


    // --- Global Root Collections ---

    // Secure user profile path: Users can ONLY access their own profile
    match /users/{uid} {
      allow read, create, update: if isAuthenticated() && request.auth.uid == uid;
    }

    // Root invites collection
    match /invites/{code} {
      allow get: if isAuthenticated();

      allow create: if isAuthenticated() &&
        request.resource.data.shop_id != null &&
        isShopOwner(request.resource.data.shop_id) &&
        request.resource.data.code == code;

      allow update: if isAuthenticated() && (
        isShopOwner(resource.data.shop_id) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['is_used', 'used_by', 'used_at']) &&
          resource.data.is_used == false &&
          request.resource.data.is_used == true &&
          request.resource.data.used_by == request.auth.uid
        )
      );

      allow delete: if isAuthenticated() && isShopOwner(resource.data.shop_id);
    }


    // --- Shop Subtree ---

    match /shops/{shopId} {
      // Direct resource.data inspection without extra get() self-read calls
      allow read: if isAuthenticated() && (
        resource.data.owner_user_id == request.auth.uid ||
        isShopMember(shopId)
      );

      allow create: if isAuthenticated() && (
        request.resource.data.owner_user_id == request.auth.uid
      );

      allow update, delete: if isAuthenticated() && (
        resource.data.owner_user_id == request.auth.uid ||
        getMemberRole(shopId) == 'OWNER'
      );


      // Shop Members Subcollection
      match /members/{uid} {
        allow read: if isAuthenticated() && (request.auth.uid == uid || isShopMember(shopId));

        // Create: Allowed for Shop Owners, or owner registering their own initial member record, OR new user joining via valid unused invite code
        allow create: if isAuthenticated() && (
          isShopOwner(shopId) ||
          (request.auth.uid == uid &&
           get(/databases/$(database)/documents/shops/$(shopId)).data.owner_user_id == request.auth.uid &&
           request.resource.data.role == 'OWNER') ||
          (
            request.auth.uid == uid &&
            exists(/databases/$(database)/documents/invites/$(request.resource.data.invite_code)) &&
            get(/databases/$(database)/documents/invites/$(request.resource.data.invite_code)).data.shop_id == shopId &&
            get(/databases/$(database)/documents/invites/$(request.resource.data.invite_code)).data.role == request.resource.data.role &&
            get(/databases/$(database)/documents/invites/$(request.resource.data.invite_code)).data.is_used == false &&
            get(/databases/$(database)/documents/invites/$(request.resource.data.invite_code)).data.expires_at > request.time.toMillis() &&
            getAfter(/databases/$(database)/documents/invites/$(request.resource.data.invite_code)).data.is_used == true &&
            getAfter(/databases/$(database)/documents/invites/$(request.resource.data.invite_code)).data.used_by == request.auth.uid
          )
        );

        // Update and Delete: ONLY the Shop Owner can modify or remove existing member records!
        allow update, delete: if isAuthenticated() && isShopOwner(shopId);
      }


      // --- Public Scope ---
      match /scopes/public/{collection}/{docId} {
        allow read: if isShopMember(shopId);
        allow create, update: if isShopOwner(shopId) || isStaff(shopId);
        allow delete: if isShopOwner(shopId);
      }


      // --- Vault Summaries ---
      match /scopes/vault/summaries/{date} {
        allow read: if isShopOwner(shopId) || isPartner(shopId);
        allow create, update, delete: if isShopOwner(shopId);
      }


      // --- Vault Scope Collections ---
      match /scopes/vault/collections/{collection}/{docId} {
        allow read: if isShopOwner(shopId) || isPartner(shopId);

        allow create: if (isShopOwner(shopId) || isStaff(shopId)) &&
          request.resource.data.shop_id == shopId &&
          request.resource.data.scope == 'VAULT';

        allow update: if isShopOwner(shopId) && collection != 'payments';
        allow delete: if isShopOwner(shopId);
      }

      match /scopes/vault/{collection}/{docId} {
        allow read: if isShopOwner(shopId) || isPartner(shopId);

        allow create: if (isShopOwner(shopId) || isStaff(shopId)) &&
          request.resource.data.shop_id == shopId &&
          request.resource.data.scope == 'VAULT';

        allow update: if isShopOwner(shopId) && collection != 'payments';
        allow delete: if isShopOwner(shopId);
      }
    }
  }
}
